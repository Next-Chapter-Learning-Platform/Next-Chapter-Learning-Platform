      "text": "even deeper into recursive types and"
    },
    {
      "startSeconds": 845.28,
      "durationSeconds": 4.28,
      "text": "template literal type parsing."
    },
    {
      "startSeconds": 848.24,
      "durationSeconds": 4.2,
      "text": "The foundation"
    },
    {
      "startSeconds": 849.56,
      "durationSeconds": 4.84,
      "text": "of fully typed APIs."
    },
    {
      "startSeconds": 852.44,
      "durationSeconds": 4.6,
