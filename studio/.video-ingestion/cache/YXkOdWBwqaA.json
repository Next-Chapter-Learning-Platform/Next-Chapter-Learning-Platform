    },
    {
      "startSeconds": 189.44,
      "durationSeconds": 4.32,
      "text": "The token bucket algorithm solves the"
    },
    {
      "startSeconds": 191.519,
      "durationSeconds": 4.561,
      "text": "fixed window problem. It's the industry"
    },
    {
      "startSeconds": 193.76,
