# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Sanity content API
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-31
# Server-only Viewer token for the private dataset
SANITY_API_READ_TOKEN=your_viewer_token

# Intelligent search (server only)
# Copy the GROQ-mode endpoint URL from the Sanity Dashboard Context app.
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v1/context/organizations/your_organization_id/mcp/vertex-search
# Organization token with the least-privilege Context Viewer role.
SANITY_ORGANIZATION_TOKEN=your_context_viewer_token
OPENAI_API_KEY=your_openai_api_key
OPENAI_SEARCH_MODEL=your_tool_capable_openai_model

# PostHog browser analytics (the project token is public by design)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
